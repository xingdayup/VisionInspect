{
  "name": "visioninspect-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" index.html",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" index.html",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "@radix-ui/react-toggle-group": "1.2.1",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "prettier": "3.6.2",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  }
}
