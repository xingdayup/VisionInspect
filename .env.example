# 在服务器显式导出这些变量；不包含密钥。
# AutoDL 实例直接用 scripts/env_autodl.sh，它会覆盖下面两个路径。
VISIONINSPECT_STATE_DIR=outputs/service
VISIONINSPECT_RELOCATED_ASSETS=1
VISIONINSPECT_GPU_ENABLED=1
# 必须指向已安装 vLLM 的解释器；下面仅是 PAI 示例路径
VISIONINSPECT_VLLM_PYTHON=/usr/local/bin/python3
# 必须指向本实例的 GPU 资产根目录；pai_vllm.py 不再内置默认值
VISIONINSPECT_GPU_ROOT=/mnt/systemDisk/VisionInspect-GPU
